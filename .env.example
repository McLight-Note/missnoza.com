# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local. Variables starting with NEXT_PUBLIC_ are sent to
# the browser; everything else stays on the server.

# ── Site ────────────────────────────────────────────────────────────────
# Public address of the site, no trailing slash. Used in emails and SEO.
NEXT_PUBLIC_SITE_URL=

# ── Firebase web app (public config; safe in the browser) ───────────────
# Firebase console → Project settings → General → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (SECRET; server only) ────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new
# private key. Copy the three values from the downloaded JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n sequences exactly as they appear in the JSON.
FIREBASE_PRIVATE_KEY=

# ── Admin access ────────────────────────────────────────────────────────
# Admins sign in with email + password, created with:
#   npm run admin:create -- admin@example.com
# Optional: move the admin area from /admin to an address that is hard to
# guess (8-64 lowercase letters, digits or hyphens), e.g. boshqaruv-7k2m9x4q.
# The login page is then /<ADMIN_PATH>/login. Keep the real value private.
ADMIN_PATH=

# ── Email (Resend) ──────────────────────────────────────────────────────
# SECRET. https://resend.com → API Keys.
RESEND_API_KEY=
# Sender shown on emails; the domain must be verified in Resend.
EMAIL_FROM="Miss Noza <orders@example.com>"
# Where new-order notifications go (can be overridden in Admin → Settings).
ORDER_NOTIFICATION_EMAIL=

# ── Telegram new-order notifications (optional) ─────────────────────────
# SECRET. Create a bot with @BotFather (/newbot) and paste its token here.
TELEGRAM_BOT_TOKEN=
# Chat IDs that receive "new order" messages, comma-separated, e.g.
# 111111111,-1002222222222 (groups start with -). Each admin must press Start
# in the bot first. Find the IDs with: npm run telegram:chat-ids
TELEGRAM_ADMIN_CHAT_IDS=
# Optional: leave customer details out of the Telegram message. Any of:
# name,phone,telegram,address,notes
TELEGRAM_OMIT_FIELDS=
# SECRET. Random string (16+ characters). Vercel Cron sends it to
# /api/cron/telegram, which retries notifications that failed or got stuck.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# ── Optional ────────────────────────────────────────────────────────────
# Random string used when hashing IP addresses for rate limiting.
RATE_LIMIT_SALT=
# Only for automated tests: send email to a local mock instead of Resend.
# RESEND_API_URL=
# Only for automated tests: send Telegram messages to a local mock.
# TELEGRAM_API_URL=

# ── Local development with the Firebase emulators (optional) ────────────
# Uncomment these INSTEAD of the real Firebase values above to develop
# without a Firebase project. Never set them on Vercel.
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-missnoza
# NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-missnoza
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
