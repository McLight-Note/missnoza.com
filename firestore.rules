rules_version = '2';

// Miss Noza — Firestore security rules.
//
// The website reads and writes through its own server (Firebase Admin SDK),
// which bypasses these rules. The rules therefore describe what a browser
// talking to Firestore DIRECTLY may do: almost nothing. They are the safety
// net that keeps data private even if someone uses the public web API key.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin = a verified email plus the `admin` custom claim, which only the
    // server (or the grant-admin script) can set. Nothing stored in a
    // document, and nothing a browser sends, can make someone an admin.
    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true
        && request.auth.token.email_verified == true;
    }

    // Catalogue: anyone may read visible products; only admins see hidden
    // ones. All writes go through the server.
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Orders hold customer contact details: admins only. Nobody can create,
    // change or delete an order from a browser — prices, totals, stock and
    // status are decided on the server.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Store settings include the owner's notification email: admins only.
    // (The storefront gets the public parts from the server.)
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Product photos are stored here and served by the website at /img/<id>.
    // Browsers never read or write them directly.
    match /productImages/{imageId} {
      allow read, write: if false;
    }

    // Internal bookkeeping: never readable or writable from a browser.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Anything not listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
