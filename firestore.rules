rules_version = '2';

// Miss Noza — Firestore security rules.
//
// The website reads and writes through its own server (Firebase Admin SDK),
// which bypasses these rules. The rules therefore describe what a browser
// talking to Firestore DIRECTLY may do: almost nothing. They are the safety
// net that keeps data private even if someone uses the public web API key.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin = a verified email plus the `admin` custom claim, which only the
    // server (or the grant-admin script) can set. Nothing stored in a
    // document, and nothing a browser sends, can make someone an admin.
    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true
        && request.auth.token.email_verified == true;
    }

    // Catalogue: anyone may read visible products; only admins see hidden
    // ones. All writes go through the server.
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Orders hold customer contact details. A signed-in customer may read
    // only orders placed with their own account; admins may read all.
    // Nobody can create, change or delete an order from a browser — prices,
    // totals, stock and status are decided on the server.
    match /orders/{orderId} {
      allow get: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Customer profiles: the owner may read their own profile and edit only
    // the listed contact fields (never roles or anyone else's profile).
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'phone', 'address', 'areaId', 'email', 'updatedAt'])
        && validProfile();
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'address', 'areaId', 'updatedAt'])
        && validProfile();
      allow delete: if false;
    }

    function shortText(d, field, max) {
      return !(field in d) || (d[field] is string && d[field].size() <= max);
    }

    function validProfile() {
      return shortText(request.resource.data, 'name', 80)
        && shortText(request.resource.data, 'phone', 32)
        && shortText(request.resource.data, 'address', 300)
        && shortText(request.resource.data, 'areaId', 64);
    }

    // Store settings include the owner's notification email: admins only.
    // (The storefront gets the public parts from the server.)
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Product photos are stored here and served by the website at /img/<id>.
    // Browsers never read or write them directly.
    match /productImages/{imageId} {
      allow read, write: if false;
    }

    // Internal bookkeeping: never readable or writable from a browser.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Anything not listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
